        "# ─── Build Bi-LSTM model ──────────────────────────────────────────────────────\n",
        "def build_bilstm_model(vocab_size, embed_dim, max_len, num_classes):\n",
        "    model = Sequential([\n",
        "        Embedding(input_dim=vocab_size, output_dim=embed_dim,\n",
        "                  input_length=max_len, name='embedding'),\n",
        "        Bidirectional(LSTM(128, return_sequences=True, dropout=0.2,\n",
        "                           recurrent_dropout=0.2), name='bilstm_1'),\n",
        "        Bidirectional(LSTM(64, dropout=0.2, recurrent_dropout=0.2),\n",
        "                      name='bilstm_2'),\n",
        "        Dense(64, activation='relu', name='dense_1'),\n",
        "        Dropout(0.4, name='dropout'),\n",
        "        Dense(num_classes, activation='softmax', name='output')\n",
        "    ])\n",
        "    model.compile(\n",
        "        optimizer=tf.keras.optimizers.Adam(learning_rate=1e-3),\n",
        "        loss='sparse_categorical_crossentropy',\n",
        "        metrics=['accuracy']\n",
        "    )\n",
        "    return model\n",
        "\n",
        "bilstm_model = build_bilstm_model(VOCAB_SIZE, EMBED_DIM, MAX_LEN, NUM_CLASSES)\n",
        "bilstm_model.summary()"
      ]
