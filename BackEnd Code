      "source": [
        "# ─── Risk scoring helper ─────────────────────────────────────────────────────\n",
        "SAFE_LABELS = {'neither', 'not_cyberbullying', 'age', 'ethnicity', 'gender', 'religion'}\n",
        "# Labels considered clearly harmful — adjust based on your combined label set\n",
        "HIGH_RISK_LABELS = {'hate_speech', 'cyberbullying', 'harassment', 'racism'}\n",
        "\n",
        "def get_risk_level(predicted_label: str, top_confidence: float) -> str:\n",
        "    \"\"\"Return Low / Medium / High based on label and confidence.\"\"\"\n",
        "    label_lower = predicted_label.lower()\n",
        "    if any(h in label_lower for h in ['hate', 'cyberbull', 'harass', 'racis']):\n",
        "        return 'HIGH 🔴' if top_confidence >= 0.60 else 'MEDIUM 🟡'\n",
        "    elif label_lower in ('offensive_language', 'offensive'):\n",
        "        return 'MEDIUM 🟡' if top_confidence >= 0.60 else 'LOW 🟢'\n",
        "    else:\n",
        "        return 'LOW 🟢'\n",
        "\n",
        "def predict_text(text: str, use_bilstm: bool = True):\n",
        "    \"\"\"\n",
        "    Analyse text with RespectNet.\n",
        "    Returns: predicted_label, confidence_scores dict, risk_level\n",
        "    \"\"\"\n",
        "    clean = preprocess_text(text)\n",
        "\n",
        "    if use_bilstm:\n",
        "        seq   = tokenizer.texts_to_sequences([clean])\n",
        "        pad   = pad_sequences(seq, maxlen=MAX_LEN, padding='post', truncating='post')\n",
        "        probs = bilstm_model.predict(pad, verbose=0)[0]\n",
        "    else:\n",
        "        # Fallback to LR for probability estimates\n",
        "        vec   = tfidf.transform([clean])\n",
        "        probs = lr_model.predict_proba(vec)[0]\n",
        "\n",
        "    pred_idx   = int(np.argmax(probs))\n",
        "    pred_label = le.classes_[pred_idx]\n",
        "    confidence_scores = {le.classes_[i]: float(probs[i]) for i in range(len(le.classes_))}\n",
        "    risk_level = get_risk_level(pred_label, probs[pred_idx])\n",
        "\n",
        "    return pred_label, confidence_scores, risk_level\n",
        "\n",
        "print('✅ Prediction function ready.')"
      ]
    },
