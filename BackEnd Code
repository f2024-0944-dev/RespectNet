        "STOP_WORDS = set(stopwords.words('english'))\n",
        "lemmatizer = WordNetLemmatizer()\n",
        "\n",
        "def preprocess_text(text: str) -> str:\n",
        "    \"\"\"Full preprocessing pipeline for a single text string.\"\"\"\n",
        "    # 1. Lowercase\n",
        "    text = text.lower()\n",
        "    # 2. Remove URLs\n",
        "    text = re.sub(r'http\\S+|www\\.\\S+', '', text)\n",
        "    # 3. Remove mentions & hashtags (keep the word after #)\n",
        "    text = re.sub(r'@\\w+', '', text)\n",
        "    text = re.sub(r'#', '', text)\n",
        "    # 4. Remove HTML tags\n",
        "    text = re.sub(r'<.*?>', '', text)\n",
        "    # 5. Remove non-alphabetic characters (keep spaces)\n",
        "    text = re.sub(r'[^a-z\\s]', ' ', text)\n",
        "    # 6. Tokenise\n",
        "    tokens = text.split()\n",
        "    # 7. Remove stopwords & lemmatise\n",
        "    tokens = [lemmatizer.lemmatize(t) for t in tokens if t not in STOP_WORDS and len(t) > 1]\n",
        "    return ' '.join(tokens)\n",
        "\n",
        "print('Preprocessing pipeline defined.')\n",
        "# Quick test\n",
        "sample = \"You're an idiot! Visit http://spam.com #hateful @user123\"\n",
        "print(f'Original : {sample}')\n",
        "print(f'Processed: {preprocess_text(sample)}')"
      ]
    },
