        "# ─── Pretty-print prediction result ──────────────────────────────────────────\n",
        "def print_prediction(text: str, use_bilstm: bool = True):\n",
        "    pred_label, scores, risk = predict_text(text, use_bilstm=use_bilstm)\n",
        "    top_conf = scores[pred_label] * 100\n",
        "\n",
        "    print('\\n' + '═'*55)\n",
        "    print('  🛡️  RespectNet Analysis')\n",
        "    print('═'*55)\n",
        "    print(f'  Input     : {text[:120]}')\n",
        "    print(f'  Category  : {pred_label.upper()}')\n",
        "    print(f'  Confidence: {top_conf:.1f}%')\n",
        "    print(f'  Risk Level: {risk}')\n",
        "    print('─'*55)\n",
        "    print('  Per-Category Scores:')\n",
        "    sorted_scores = sorted(scores.items(), key=lambda x: x[1], reverse=True)\n",
        "    for label, score in sorted_scores:\n",
        "        bar   = '█' * int(score * 20)\n",
        "        mark  = ' ◀' if label == pred_label else ''\n",
        "        print(f'    {label:<30} {score*100:5.1f}%  {bar}{mark}')\n",
        "    print('═'*55 + '\\n')"
      ]
